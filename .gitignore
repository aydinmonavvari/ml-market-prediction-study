# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/

# --- tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- environment / secrets ---
.env
.env.*
*.token

# --- data: raw downloads & processed artifacts are never committed ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- OS noise ---
.DS_Store
Thumbs.db

# --- editors ---
.vscode/
.idea/
